---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ApplianceIcon from '../../components/ApplianceIcon.astro';
import { site } from '../../lib/site';
import { applianceColor } from '../../lib/icons';
import { breadcrumbSchema, faqSchema } from '../../lib/schema';

const problems = await getCollection('problems');

const byAppliance = problems.reduce<Record<string, typeof problems>>((acc, problem) => {
  const key = problem.data.appliance;
  acc[key] = acc[key] ? [...acc[key], problem] : [problem];
  return acc;
}, {});

const breadcrumbItems = [{ name: 'Home', url: '/' }, { name: 'Self-Help', url: '/problems/' }];

const faq = faqSchema([
  {
    question: 'Should I try to fix this myself, or call a technician?',
    answer:
      "Each guide's causes section flags what's safe to check yourself (like a clogged filter or tripped breaker) versus what usually means a failed part. When in doubt, or if you smell burning or see sparking, stop using the appliance and call us.",
  },
  {
    question: "I don't see my exact symptom listed — what should I do?",
    answer: `Call us at ${site.phoneDisplay} and describe what's happening. Our technicians can usually narrow down the likely cause over the phone before they even arrive.`,
  },
  {
    question: 'Will fixing this myself void my repair warranty with you?',
    answer:
      "Our 90-day warranty covers the repair work we perform. Checking simple things yourself first (like the ones listed in these guides) doesn't affect that — it's exactly what we'd ask you to check anyway.",
  },
]);
---

<Layout
  title={`Self-Help Guides: Common Appliance Problems | ${site.name}`}
  description="Symptoms and causes for the most common washer, dryer, refrigerator, oven, dishwasher, microwave, and disposal problems in Las Vegas."
  schema={[
    breadcrumbSchema(breadcrumbItems.map((i) => ({ ...i, url: new URL(i.url, Astro.site).toString() }))),
    faq,
  ]}
>
  <Breadcrumbs items={breadcrumbItems} />

  <section class="mx-auto max-w-7xl px-4 py-12">
    <h1 class="text-3xl font-bold text-slate-900 sm:text-4xl lg:text-5xl dark:text-white">Self-Help Guides</h1>
    <p class="mt-3 max-w-2xl text-slate-600 dark:text-slate-400">
      Not sure what's wrong? Find your symptom below to see likely causes and how we fix it.
    </p>

    {Object.entries(byAppliance).map(([appliance, items]) => (
      <div class="mt-10">
        <h2 class="flex items-center gap-2 text-lg font-semibold text-slate-900 dark:text-white">
          <span class={`inline-flex rounded-md p-1.5 ${applianceColor(appliance).bg} ${applianceColor(appliance).text}`}>
            <ApplianceIcon name={appliance} class="h-4 w-4" />
          </span>
          {appliance}
        </h2>
        <div class="mt-4 grid gap-4 sm:grid-cols-2">
          {items.map((problem) => (
            <a
              href={`/problems/${problem.id}/`}
              class="block rounded-lg border border-slate-200 p-5 transition hover:border-blue-300 hover:shadow-md dark:border-slate-800 dark:hover:border-blue-700"
            >
              <h3 class="font-semibold text-slate-900 dark:text-white">{problem.data.title}</h3>
              <span class="mt-2 inline-block text-sm font-semibold text-blue-700 dark:text-blue-400">See causes &rarr;</span>
            </a>
          ))}
        </div>
      </div>
    ))}

    <div class="mt-12 max-w-2xl">
      <h2 class="text-xl font-semibold text-slate-900 dark:text-white">Common Questions</h2>
      <div class="mt-4 space-y-4">
        {faq.mainEntity.map((item) => (
          <div>
            <h3 class="font-semibold text-slate-900 dark:text-white">{item.name}</h3>
            <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">{item.acceptedAnswer.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>
